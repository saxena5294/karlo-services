PORT=5000
NODE_ENV=development
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Comma-separated frontend origins accepted by Clerk token validation.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
# Optional recipient (Clerk user ID) for application-submitted admin notifications.
DEV_ADMIN_USER_ID=
MONGO_URI=mongodb://127.0.0.1:27017/karlo
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_REAL_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_REAL_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_REAL_API_SECRET
# Customer document uploads are clamped between 1 MB and 25 MB.
CUSTOMER_DOCUMENT_MAX_MB=10
# Documents expiring within this many days are marked expiring soon.
DOCUMENT_EXPIRY_WARNING_DAYS=30
# Mobile verification. Production requires strong independent secrets.
OTP_HASH_SECRET=
OTP_TOKEN_SECRET=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# Supported providers: turnstile, recaptcha. Production submissions fail closed when absent.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
LEAD_MARKETPLACE_ENABLED=false
